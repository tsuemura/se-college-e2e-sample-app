// 講座のデモ環境を Cloudflare Containers にデプロイする設定
//   cd deploy/cloudflare && npm install && npx wrangler deploy
// アプリ本体には手を入れず、リポジトリ直下の Dockerfile をそのまま動かす。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "se-college-demo",
  "main": "worker.js",
  "compatibility_date": "2026-06-01",
  "workers_dev": true,
  "observability": { "enabled": true },
  "containers": [
    {
      "class_name": "AppContainer",
      "image": "./Dockerfile",
      "image_build_context": "../..",
      "max_instances": 1,
      "instance_type": "lite"
    }
  ],
  "durable_objects": {
    "bindings": [{ "name": "APP", "class_name": "AppContainer" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["AppContainer"] }]
}
